{
	"name": "svelte-s3client",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "bun run check && vite build",
		"test": "vitest run",
		"preview": "wrangler dev .svelte-kit/cloudflare/_worker.js --port 4173",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"gen": "wrangler types"
	},
	"devDependencies": {
		"@sveltejs/adapter-cloudflare": "^7.2.8",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.16",
		"vitest": "^5.0.1",
		"wrangler": "4.136.3"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.1138.0",
		"@aws-sdk/lib-storage": "^3.1138.0",
		"@aws-sdk/s3-request-presigner": "^3.1138.0",
		"@fontsource/geist-mono": "^5.3.0",
		"@fontsource/geist-sans": "^5.3.0",
		"@lucide/svelte": "^1.47.0",
		"clsx": "^2.1.1",
		"fflate": "^0.8.3",
		"mode-watcher": "^1.1.0",
		"svelte-sonner": "^1.2.1",
		"tailwind-merge": "^3.7.0",
		"zod": "^4.6.5"
	}
}
