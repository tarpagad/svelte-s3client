{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "svelte-s3client",
	"compatibility_date": "2026-09-23",
	"compatibility_flags": [
		"nodejs_compat",
		"nodejs_als"
	],
	"limits": {
		"cpu_ms": 300000
	},
	"main": ".svelte-kit/cloudflare/_worker.js",
	"alias": {
		// The package's `browser` field swaps in a DOMParser-based XML
		// parser ("DOMParser is not defined" in workerd on every S3
		// response); the dist-cjs build is self-contained pure JS.
		"@aws-sdk/xml-builder": "./node_modules/@aws-sdk/xml-builder/dist-cjs/index.js"
	},
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"workers_dev": true,
	"preview_urls": true,
	"observability": {
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1,
			"invocation_logs": true,
			"persist": true
		},
		"traces": {
			"enabled": false,
			"head_sampling_rate": 1,
			"persist": true
		}
	},
}
